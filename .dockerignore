# ─── Docker Build Context Exclusions ─────────────────────────────────────────
# Keeps the build context lean — only source files reach the Docker daemon.
# node_modules and .next are rebuilt inside the container during the build stage.

# Dependencies (rebuilt by npm ci inside the container)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output (rebuilt by npm run build inside the container)
.next
out

# Git internals
.git
.gitignore

# Environment files — secrets must NEVER enter the image
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# Keep .env.example — it contains only placeholder values, useful for reference
# (no exclusion rule for .env.example)

# IDE and editor files
.vscode
.idea
*.swp
*.swo

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Test and coverage output
coverage
.nyc_output

# TypeScript incremental build cache
*.tsbuildinfo

# Logs
*.log

# Kiro workspace files
.kiro
